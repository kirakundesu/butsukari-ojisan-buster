{
  "name": "butsukari-ojisan-buster",
  "version": "0.1.0",
  "private": true,
  "description": "ぶつかろうとしてくるおじさんに体当たりを返してぶっとばすブラウザゲーム",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply butsukari-ojisan-buster --local",
    "db:migrate:remote": "wrangler d1 migrations apply butsukari-ojisan-buster --remote",
    "deploy": "wrangler deploy",
    "test": "node --test \"tests/*.test.*\"",
    "build:artifact": "node tools/build-artifact.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
